{
  "name": "per_team network with cidr_template + gateway_template — both rendered per team id",
  "operator": "expand_replication",
  "input": {
    "document": {
      "schema_version": "1.0",
      "kind": "gamenet",
      "name": "per-team network gateway fixture",
      "nodes": [
        { "id": "net-lab", "kind": "network",
          "replication": { "scope": "per_team" },
          "config": {
            "cidr_template": "192.168.{140+team_id}.0/24",
            "gateway_template": "192.168.{140+team_id}.1"
          } }
      ]
    },
    "team_count": 2
  },
  "expected": {
    "plays_per_team": 2,
    "handler_namespaces": [],
    "document": {
      "schema_version": "1.0",
      "kind": "gamenet",
      "name": "per-team network gateway fixture",
      "nodes": [
        { "id": "net-lab__team_1", "kind": "network",
          "replication": { "scope": "per_team" },
          "config": { "cidr": "192.168.141.0/24", "gateway": "192.168.141.1" } },
        { "id": "net-lab__team_2", "kind": "network",
          "replication": { "scope": "per_team" },
          "config": { "cidr": "192.168.142.0/24", "gateway": "192.168.142.1" } }
      ]
    }
  }
}
